# List the classic books whose word count is closest to your number
def main [
  number: int
] {
  $BOOKS
  | sort-by {|book| $book.words - $number | math abs }
  | first 3
  | each {|book| $"($book.title) by ($book.author) \((abbreviate $book.words))" }
  | to text
}

def abbreviate [words] {
  if $words >= 1_000_000 {
    $"~($words / 1_000_000 | into string --decimals 2)M"
  } else {
    $"~($words / 1_000 | math round)k"
  }
}
