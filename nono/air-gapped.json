{
  "meta": {
    "name": "air-gapped",
    "description": "Run pi without file system access"
  },
  "groups": {
    "include": ["node_runtime", "linux_temp_read"]
  },
  "filesystem": {
    "allow": [
      "~/.local/share/NuGet",
      "~/.local/share/mise",
      "~/.nuget",
      "~/.pi/agent/"
    ],
    "read": [
      "/etc/gitconfig",
      "~/.cargo/bin",
      "~/.config/mise/config.toml",
      "~/.config/nvim",
      "~/.dotnet",
      "~/.gitconfig",
      "~/.local/share/nvim",
      "~/projects/dotfiles/nvim/",
      "~/projects/dotfiles/pi/"
    ]
  },
  "environment": {
    "allow_vars": [
      "EDITOR",
      "HOME",
      "MCPC_HOME_DIR",
      "NONO_PROFILE",
      "PATH",
      "TERM"
    ],
    "set_vars": {
      "XDG_CACHE_HOME": "/tmp/nono-xdg/cache",
      "XDG_STATE_HOME": "/tmp/nono-xdg/state"
    }
  }
}
